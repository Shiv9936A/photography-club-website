{
  "kind": "collectionType",
  "collectionName": "photos",
  "info": {
    "singularName": "photo",
    "pluralName": "photos",
    "displayName": "Photos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "private"],
      "default": "private",
      "required": true
    },
    "capturedDate": {
      "type": "date"
    },

    "uploadedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },

    "capturedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "tag": {
      "type": "enumeration",
      "enum": [
        "Event",
        "Workshop",
        "Portrait",
        "Nature",
        "Street",
        "Wildlife",
        "Sports",
        "Club Activity",
        "Other"
      ]
    },

    "likesCount": {
      "type": "integer",
      "default": 0
    }
  }
}
